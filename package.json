{
  "name": "me2-json-quiz-cloudflare",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"console.log('No build needed. Cloudflare Pages output directory is project root: .');\"",
    "test": "node --test",
    "check": "node --check functions/_middleware.js && node --check functions/_shared/ip-block.js",
    "dev": "wrangler pages dev .",
    "deploy": "npm run deploy:pages",
    "deploy:pages": "wrangler pages deploy . --project-name me2-json-quiz --branch=main",
    "deploy:worker": "wrangler deploy --config wrangler.worker.toml",
    "deploy:worker:config": "wrangler deploy --config wrangler.worker.toml"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
