{
  "name": "me2-json-quiz-cloudflare",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "build": "node -e \"console.log('No build needed. Static files are served from project root.');\"",
    "dev": "wrangler pages dev .",
    "deploy": "wrangler pages deploy . --project-name me2-json-quiz",
    "deploy:pages": "wrangler pages deploy . --project-name me2-json-quiz",
    "deploy:worker": "wrangler deploy --config wrangler.worker.toml"
  },
  "devDependencies": {
    "wrangler": "latest"
  }
}
